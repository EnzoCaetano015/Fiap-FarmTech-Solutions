[Unit]
Description=FarmTech Streamlit dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/farmtech
EnvironmentFile=/opt/farmtech/.env
Environment=FARMTECH_STATE_DIR=/var/lib/farmtech
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/farmtech/.venv/bin/python -m streamlit run dashboard/src/dashboard.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
