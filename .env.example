# Configuração; nunca adicionar credenciais AWS persistentes.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
AWS_DEFAULT_REGION=us-east-1
FARMTECH_SNS_TOPIC_ARN=
# Linux/EC2: /var/lib/farmtech. Vazio => .runtime na raiz do projeto.
# FARMTECH_STATE_DIR=/var/lib/farmtech
# FARMTECH_VISION_BUNDLE=/opt/farmtech/models/tomate
# FARMTECH_YOLO_RUNTIME=/opt/farmtech/.runtime/yolov5
YOLOv5_AUTOINSTALL=false
